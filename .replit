modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0", "flask_google_oauth:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "libyaml", "openssl", "pkg-config", "postgresql", "rustc", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Context Foundry Web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Brain Service"

[[workflows.workflow]]
name = "Context Foundry Web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python platform_app.py"
waitForPort = 5000

[[workflows.workflow]]
name = "Brain Service"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python brain/app.py"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34239
externalPort = 8008

[[ports]]
localPort = 34787
externalPort = 3000

[[ports]]
localPort = 35381
externalPort = 5000

[[ports]]
localPort = 35709
externalPort = 5173

[[ports]]
localPort = 37569
externalPort = 3002

[[ports]]
localPort = 40045
externalPort = 4200

[[ports]]
localPort = 40087
externalPort = 6800

[[ports]]
localPort = 41291
externalPort = 6000

[[ports]]
localPort = 41663
externalPort = 3003

[[ports]]
localPort = 42015
externalPort = 3001

[[ports]]
localPort = 43175
externalPort = 8000

[[ports]]
localPort = 44089
externalPort = 8099

[[ports]]
localPort = 44307
externalPort = 8081

[[ports]]
localPort = 44997
externalPort = 8080

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "--workers", "2", "web_app:app"]

[userenv]

[userenv.shared]
BRAIN_INTERNAL_URL = "http://localhost:3000"
