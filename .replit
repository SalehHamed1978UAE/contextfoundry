modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "libyaml", "postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Context Foundry Web"

[[workflows.workflow]]
name = "Context Foundry Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34787
externalPort = 3000

[[ports]]
localPort = 35381
externalPort = 5000

[[ports]]
localPort = 35709
externalPort = 5173

[[ports]]
localPort = 37569
externalPort = 3002

[[ports]]
localPort = 40045
externalPort = 4200

[[ports]]
localPort = 41663
externalPort = 3003

[[ports]]
localPort = 42015
externalPort = 3001

[[ports]]
localPort = 44377
externalPort = 6000

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "--workers", "2", "web_app:app"]
