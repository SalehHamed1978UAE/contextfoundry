modules = ["python-3.11"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Context Foundry CLI"

[[workflows.workflow]]
name = "Context Foundry CLI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --demo"

[workflows.workflow.metadata]
outputType = "console"
