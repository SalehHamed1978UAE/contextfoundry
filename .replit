modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Context Foundry CLI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Context Foundry Web"

[[workflows.workflow]]
name = "Context Foundry CLI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --demo"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Context Foundry Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34787
externalPort = 3000

[[ports]]
localPort = 39487
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "--workers", "2", "web_app:app"]
