modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0", "flask_google_oauth:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cargo", "chromium", "cups", "dbus", "expat", "gdk-pixbuf", "gitFull", "glib", "glibcLocales", "gtk3", "libdrm", "libiconv", "libxcrypt", "libyaml", "mesa", "nspr", "nss", "openssl", "pango", "pkg-config", "playwright-driver", "poppler", "poppler_utils", "postgresql", "rapidfuzz-cpp", "rustc", "taskflow", "tesseract", "unzip", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start All"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Re-extraction"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RE Agent Batch"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "E2E Lifecycle Test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "235Q Test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test: Manus Healthtec"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test: ClaudeCode Medsync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test: Manus Medsync"

[[workflows.workflow]]
name = "Start All"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Re-extraction"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/full_reextraction.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "RE Agent Batch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/re_agent_batch.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "E2E Lifecycle Test"
author = "agent"
mode = "parallel"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/e2e_lifecycle_test.py 2>&1 | tee /tmp/e2e_run.log"

[[workflows.workflow]]
name = "235Q Test"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -u scripts/run_200_question_test.py 2>&1"

[[workflows.workflow]]
name = "Test: Manus Healthtec"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m src.test_runner.runner --corpus \"Manus Healthtec\""

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Test: ClaudeCode Medsync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m src.test_runner.runner --corpus \"ClaudeCode Medsync\""

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Test: Manus Medsync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m src.test_runner.runner --corpus \"Manus Medsync\""

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 9000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "--workers", "2", "web_app:app"]

[userenv]

[userenv.shared]
BRAIN_INTERNAL_URL = "http://localhost:3000"
USE_ONTOLOGY_CENTRIC_PIPELINE = "true"
RLM_ENABLED = "true"

[userenv.development]
