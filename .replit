modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0", "python_database:1.0.0", "flask_google_oauth:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "libyaml", "openssl", "pkg-config", "poppler", "poppler_utils", "postgresql", "rapidfuzz-cpp", "rustc", "taskflow", "tesseract", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start All"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Stress Test Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Re-extraction"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RE Agent Batch"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "E2E Lifecycle Test"

[[workflows.workflow]]
name = "Start All"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Stress Test Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -u stress_test/monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Re-extraction"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/full_reextraction.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "RE Agent Batch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/re_agent_batch.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "E2E Lifecycle Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/e2e_lifecycle_test.py --fresh 2>&1 | tee /tmp/e2e_results.log"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 9000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--reuse-port", "--workers", "2", "web_app:app"]

[userenv]

[userenv.shared]
BRAIN_INTERNAL_URL = "http://localhost:3000"
USE_ONTOLOGY_CENTRIC_PIPELINE = "true"
