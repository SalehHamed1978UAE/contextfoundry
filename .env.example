# Database Configuration
DATABASE_URL=postgresql://cf_user:cf_password@localhost:5433/context_foundry
REDIS_URL=redis://localhost:6380

# LLM Provider: "ollama" (local) or "openai" (API)
LLM_PROVIDER=ollama

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=768

# Graph Configuration
GRAPH_NAME=cf_knowledge

# Confidence Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.70
CONFIDENCE_THRESHOLD_LOW=0.50
CONFIDENCE_THRESHOLD_FLOOR=0.40

# Retrieval Settings
VECTOR_SEARCH_TOP_K=8
GRAPH_MAX_HOPS=2

# Timeouts (seconds)
LLM_TIMEOUT=600
VECTOR_SEARCH_TIMEOUT=5
GRAPH_QUERY_TIMEOUT=10

# Session Settings
SESSION_TTL_SECONDS=3600
