# Context Foundry Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Flask session secret key (use a long random string)
SESSION_SECRET=your-secure-random-session-secret-here

# PostgreSQL database connection URL
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# LLM API KEYS - At least one required for extraction/reasoning
# =============================================================================

# OpenAI API key for embeddings and GPT models
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API key for Claude Vision (optional, used for PDF extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# OPTIONAL - Authentication
# =============================================================================

# Google OAuth credentials (for SSO login)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# OPTIONAL - Encryption
# =============================================================================

# Fernet key for encrypting sensitive data (32-byte base64 encoded)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-encryption-key

# =============================================================================
# DATABASE CREDENTIALS (auto-populated by Replit if using Replit PostgreSQL)
# =============================================================================

# PGHOST=localhost
# PGPORT=5432
# PGUSER=your-db-user
# PGPASSWORD=your-db-password
# PGDATABASE=your-db-name
