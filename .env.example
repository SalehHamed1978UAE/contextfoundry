# Database Configuration
DATABASE_URL=postgresql://cf_user:cf_password@localhost:5433/context_foundry
REDIS_URL=redis://localhost:6380

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Graph Configuration
GRAPH_NAME=cf_knowledge

# Confidence Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.70
CONFIDENCE_THRESHOLD_LOW=0.50
CONFIDENCE_THRESHOLD_FLOOR=0.40

# Retrieval Settings
VECTOR_SEARCH_TOP_K=5
GRAPH_MAX_HOPS=2

# Timeouts (seconds)
LLM_TIMEOUT=30
VECTOR_SEARCH_TIMEOUT=5
GRAPH_QUERY_TIMEOUT=10

# Session Settings
SESSION_TTL_SECONDS=3600
