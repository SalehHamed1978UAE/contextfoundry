## Step 2: Ingest Documents

```python
import os
from context_foundry.core import ContextFoundry

# Initialize
cf = ContextFoundry(tenant_id=DEMO_TENANT_ID)

# Ingest all docs
demo_docs_path = "/home/claude/demo_docs/"
for filename in os.listdir(demo_docs_path):
    if filename.endswith('.md'):
        filepath = os.path.join(demo_docs_path, filename)
        with open(filepath, 'r') as f:
            content = f.read()
        
        print(f"Ingesting {filename}...")
        result = cf.ingest_document(
            content=content,
            filename=filename,
            tenant_id=DEMO_TENANT_ID
        )
        print(f"  Document ID: {result.get('document_id')}")

print("Ingestion complete. Waiting for extraction...")
```

