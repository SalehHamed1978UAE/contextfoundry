FROM apache/age:latest

# Install build dependencies and pgvector
USER root

# Detect the installed PostgreSQL major version and install matching dev headers
RUN PG_MAJOR=$(pg_config --version | sed 's/PostgreSQL //' | cut -d. -f1) && \
    echo "Detected PostgreSQL $PG_MAJOR" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-${PG_MAJOR} \
    git \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install pgvector (0.8.0+ required for PG 18 compatibility)
RUN cd /tmp && \
    git clone --branch v0.8.2 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector

USER postgres
